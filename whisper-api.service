[Unit]
Description=Whisper Transcription API
After=network.target

[Service]
User=user  # Change to your system user
Group=user  # Change to your system group
WorkingDirectory=/opt/whisper-api
ExecStart=/opt/whisper-api/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
SyslogIdentifier=whisper-api
Environment="PATH=/opt/whisper-api/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Environment variables
Environment="DIARIZATION_ENABLED=False"
Environment="DEFAULT_MODEL=medium"
Environment="DEFAULT_LANGUAGE=sv"
Environment="MAX_MODELS_IN_MEMORY=1"
Environment="PRELOAD_DEFAULT_MODEL=True"
Environment="HUGGINGFACE_TOKEN=your-token-here"  # If using diarization

[Install]
WantedBy=multi-user.target