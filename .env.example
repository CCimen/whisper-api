# Whisper Transcription API - Configuration
# Copy this file to .env and modify as needed

# ==============================
# API Settings
# ==============================
APP_NAME=Whisper Transcription API
DEBUG=False

# ==============================
# Model Settings
# ==============================
# Default model to use (tiny, small, medium, large)
DEFAULT_MODEL=medium

# Default language for transcription
DEFAULT_LANGUAGE=sv

# Directory to cache models
MODELS_CACHE_DIR=./models

# Whether to keep multiple models in memory
# Set to False to save GPU memory at the cost of model reloading
KEEP_MULTIPLE_MODELS_IN_MEMORY=False

# Maximum number of models to keep in memory
MAX_MODELS_IN_MEMORY=1

# Minimum free GPU memory to maintain (in GB)
MIN_FREE_MEMORY_GB=3.0

# Preload default model at startup
PRELOAD_DEFAULT_MODEL=True

# ==============================
# Diarization Settings
# ==============================
# Enable speaker diarization capability
DIARIZATION_ENABLED=False

# Hugging Face token for accessing diarization models
# Required if DIARIZATION_ENABLED=True
HUGGINGFACE_TOKEN=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

# Run transcription and diarization in parallel
# May use more GPU memory but improves speed
PARALLEL_PROCESSING=False

# Maximum size of audio chunks for diarization (in seconds)
# Larger chunks are more accurate but use more memory
DIARIZATION_CHUNK_DURATION=300

# ==============================
# Job Management
# ==============================
# How long to keep completed jobs in memory (hours)
JOB_CLEANUP_HOURS=24

# ==============================
# Performance Tuning
# ==============================
# Number of worker processes to use
# Recommend 1 for GPU workloads (per GPU)
UVICORN_WORKERS=1

# Socket bind address
UVICORN_HOST=0.0.0.0

# Socket port
UVICORN_PORT=8000

# Access log
UVICORN_ACCESS_LOG=False

# Use TensorFloat32 precision where available
# Set to True for better performance on A100 and newer GPUs
USE_TF32=True