# .env.example - Copy to .env and fill in your values
# Documentation: Add comments explaining each variable

# --- Application Settings ---
APP_NAME="Whisper Transcription API"
APP_VERSION="1.1.0"
# Set LOG_LEVEL to DEBUG for verbose output during development
LOG_LEVEL=INFO # DEBUG, INFO, WARNING, ERROR, CRITICAL

# --- Server Settings ---
HOST=0.0.0.0
PORT=8000
# WORKERS=1 # Uvicorn workers. Handled by CMD/process manager.

# --- Development Server Settings (for docker-compose dev service) ---
DEV_PORT=8080
# DEV_LOG_LEVEL=DEBUG # Overrides LOG_LEVEL for dev service

# --- Compute & Model Settings ---
USE_CUDA=true # Set to false to force CPU mode
CUDA_DEVICE=0 # GPU index to use if USE_CUDA=true
COMPUTE_TYPE=auto # Processing precision: auto, float16, bfloat16, float32
USE_TF32=true # Enable TF32 optimization on compatible GPUs (Ampere+)

DEFAULT_MODEL=kblab-tiny # Choose default model: openai-large-v3-turbo, kblab-tiny, kblab-small, kblab-medium, kblab-large
PRELOAD_DEFAULT_MODEL=true # Load the default model on startup (recommended for faster first request)
# DEFAULT_LANGUAGE=sv # Optional: Default language hint for transcription (e.g., "sv", "en"). Leave empty for auto-detect.

# --- Memory & Task Management ---
MAX_CONCURRENT_TASKS=1 # Adjust based on GPU VRAM (e.g., 1 for <12GB, 2 for 12-24GB, 3+ for >24GB)
KEEP_MULTIPLE_MODELS_IN_MEMORY=false # Allow keeping >1 model loaded? (Requires significant VRAM)
MAX_MODELS_IN_MEMORY=1 # Max models if KEEP_MULTIPLE_MODELS_IN_MEMORY=true
MIN_FREE_MEMORY_GB=1.5 # Minimum free VRAM before attempting to unload unused models

TASK_TIMEOUT_MINUTES=60 # Max duration for a single task
RETRY_FAILED_TASKS=false # Automatically retry failed tasks?
MAX_RETRIES=1 # Number of retries if RETRY_FAILED_TASKS=true

# --- Diarization Settings ---
DIARIZATION_ENABLED=true # Enable/disable speaker diarization feature globally
# Required if DIARIZATION_ENABLED=true. Get token from https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=TOKEN HERE
DIARIZATION_MODEL="pyannote/speaker-diarization-3.1" # Pyannote model to use
DIARIZATION_CHUNK_DURATION=30 # Base duration (seconds) for processing chunks (auto-adjusted based on VRAM)
PARALLEL_PROCESSING=true # Use parallel processing for diarization chunks if VRAM allows

# --- Storage & Privacy Settings ---
# Defaults use /tmp inside container. Mount volumes in docker-compose.
# For memory storage (Linux only), use paths like /dev/shm/whisper-uploads
UPLOAD_DIR=/app/uploads
RESULTS_DIR=/app/results
MODELS_CACHE_DIR=/app/models # Persistent model cache via volume mount recommended
MAX_UPLOAD_SIZE_MB=1024 # Max audio file size in MB

AUTO_DELETE_AFTER_COMPLETION=true # RECOMMENDED FOR PRIVACY: Delete audio files immediately after task completion/failure
JOB_CLEANUP_HOURS=24 # How long to keep task *records* in memory (0 = cleanup very quickly)
CLEAN_ALL_ON_SHUTDOWN=true # Delete all temp files/tasks on graceful shutdown
# SECURE_MEMORY_WIPING=false # Overwrite memory blocks on cleanup (expensive, limited effect)
# SECURE_FILE_WIPING=false # Overwrite files multiple times before deletion (slower)

# --- Security Settings ---
API_AUTH_REQUIRED=false # IMPORTANT: Set to true for any non-local deployment
API_KEY= # IMPORTANT: Generate a strong key if API_AUTH_REQUIRED=true -> python -c "import secrets; print(secrets.token_urlsafe(32))"
ALLOWED_HOSTS='["*"]' # CORS allowed origins (JSON list). Restrict in production, e.g., '["https://yourdomain.com"]'

# --- Audit Logging ---
AUDIT_LOGGING_ENABLED=false # Enable request/response audit logging
AUDIT_LOG_PATH=/app/logs/audit.log # Path for audit log file (inside container)

# --- Redis Settings (for Task Queue & State) ---
REDIS_HOST=localhost # Use 'redis' if using docker-compose service name
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD= # Leave empty if Redis has no password
REDIS_TIMEOUT=10 # Connection timeout in seconds
REDIS_KEY_PREFIX=whisper_api: # Prefix for all keys used by this app in Redis