[Unit]
Description=Whisper Transcription API
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=whisper  # Change to your service user
Group=whisper  # Change to your service group
WorkingDirectory=/opt/whisper-api
ExecStart=/opt/whisper-api/venv/bin/python /opt/whisper-api/run.py --host 0.0.0.0 --port 8000 --preload-model medium

# Environment configuration
EnvironmentFile=/opt/whisper-api/.env

# Restart policy
Restart=on-failure
RestartSec=10s

# Resource limits
# GPU workloads need a lot of memory
LimitMEMLOCK=infinity
LimitNOFILE=65536

# Execute pre and post scripts
ExecStartPre=/bin/mkdir -p /opt/whisper-api/logs
ExecStartPre=/bin/mkdir -p /opt/whisper-api/models

# Logging
StandardOutput=append:/opt/whisper-api/logs/whisper-api.log
StandardError=append:/opt/whisper-api/logs/whisper-api-error.log

[Install]
WantedBy=multi-user.target